# Small final layer applying the same vendor workaround as the full tools recipe.
# Kept separate so validation does not require rebuilding the complete toolchain.
ARG SOURCE_IMAGE=homelab-candidate/firmlab:20261103-pre-trust
FROM ${SOURCE_IMAGE}
RUN rm -f /etc/ssl/certs/java/cacerts && update-ca-certificates --fresh \
 && for alias in debian:emsign_root_ca_-_g1.pem debian:emsign_root_ca_-_g2.pem \
      debian:emsign_ecc_root_ca_-_g3.pem debian:aaa_certificate_services.pem; do \
      if keytool -list -cacerts -storepass changeit -alias "$alias" >/dev/null 2>&1; then \
        keytool -delete -cacerts -storepass changeit -alias "$alias" || exit 1; \
      fi; \
    done
