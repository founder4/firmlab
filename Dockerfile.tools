# syntax=docker/dockerfile:1
#
# FirmLab TOOLS BASE — the heavy reverse-engineering + emulation toolchain on a node runtime, with NO app code.
# Dockerfile.firmware layers the built app ON TOP of this image, so an app-code change rebuilds only that thin
# final layer — never these (expensive, multi-GB) tool layers. Rebuild this image ONLY when a tool recipe changes:
#   docker build -f Dockerfile.tools -t firmlab-tools:latest .
#
# Each optional heavy block is fault-tolerant (`|| echo …`): a failed install never aborts the build — the matching
# provider degrades honestly when its tool is absent (available:false / blocked_by_platform).
FROM node:22-bookworm-slim

# === Core RE + extraction + emulation toolchain (apt) ===
# binwalk (carve), squashfs-tools, cpio, e2fsprogs, radare2 (below), qemu-user-static (ALL guest arches incl.
# MIPS/ARM), qemu-system-{mips,arm} (full-system boot).
RUN apt-get update && apt-get install -y --no-install-recommends \
      binwalk \
      squashfs-tools \
      cpio \
      e2fsprogs \
      qemu-user-static \
      qemu-system-mips \
      qemu-system-arm \
      python3 python3-pip python3-venv \
      curl ca-certificates unzip \
    && rm -rf /var/lib/apt/lists/*

# === Phase 6 capture — discovery (passive LAN sweep) + interception (proxy) ===
# nmap + arp-scan power the host sweep, iproute2 (`ip`) reports the primary subnet, avahi-utils (`avahi-browse`)
# adds mDNS/DNS-SD enrichment (6.0); mitmproxy (`mitmdump`) is the on-path interception proxy for OTA capture (6.1).
# Fault-tolerant: if this fails the `discover`/proxy providers degrade honestly (the capture backends report the
# tool absent). The lane still does nothing on the wire unless FIRMLAB_CAPTURE=1 and the operator arms an action.
# (bettercap — 6.2 active positioning — is deliberately NOT here; see the last layer for why.)
RUN apt-get update && apt-get install -y --no-install-recommends \
      nmap arp-scan iproute2 avahi-utils mitmproxy \
    && rm -rf /var/lib/apt/lists/* \
    || echo "capture tools unavailable — discover/proxy degrade honestly"

# === radare2 (binary triage) — dropped from Debian bookworm repos; use the official .deb for the build arch ===
RUN R2_VER="$(curl -fsSL https://api.github.com/repos/radareorg/radare2/releases/latest | grep -oP '"tag_name":\s*"\K[0-9.]+')" \
    && ARCH="$(dpkg --print-architecture)" \
    && curl -fsSL "https://github.com/radareorg/radare2/releases/download/${R2_VER}/radare2_${R2_VER}_${ARCH}.deb" -o /tmp/r2.deb \
    && apt-get update && apt-get install -y --no-install-recommends /tmp/r2.deb \
    && rm -f /tmp/r2.deb && rm -rf /var/lib/apt/lists/*

# === JFFS2 / UBIFS extractors (pip, isolated venv) ===
RUN python3 -m venv /opt/fw-py \
    && /opt/fw-py/bin/pip install --no-cache-dir jefferson ubi_reader \
    && ln -sf /opt/fw-py/bin/jefferson /usr/local/bin/jefferson \
    && ln -sf /opt/fw-py/bin/ubireader_extract_files /usr/local/bin/ubireader_extract_files

# === SBOM + CVEs + secrets (syft / grype / gitleaks via official installers) ===
RUN curl -fsSL https://raw.githubusercontent.com/anchore/syft/main/install.sh  | sh -s -- -b /usr/local/bin \
    && curl -fsSL https://raw.githubusercontent.com/anchore/grype/main/install.sh | sh -s -- -b /usr/local/bin \
    && GL_ARCH="$(dpkg --print-architecture | sed 's/amd64/x64/;s/arm64/arm64/')" \
    && curl -fsSL https://github.com/gitleaks/gitleaks/releases/latest/download/gitleaks_$(curl -fsSL https://api.github.com/repos/gitleaks/gitleaks/releases/latest | grep -oP '"tag_name":\s*"v\K[0-9.]+')_linux_${GL_ARCH}.tar.gz \
       -o /tmp/gitleaks.tgz && tar xzf /tmp/gitleaks.tgz -C /usr/local/bin gitleaks && rm /tmp/gitleaks.tgz

# === chipsec — UEFI/BIOS offline analysis (providers/chipsec.ts) — VALIDATED (real OVMF decode). ===
RUN apt-get update && apt-get install -y --no-install-recommends build-essential python3-dev nasm \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir --break-system-packages chipsec \
    && chipsec_util --help >/dev/null 2>&1 \
    ; command -v chipsec_util >/dev/null && echo "chipsec OK" || echo "chipsec optional install failed — UEFI provider degrades honestly"

# === Renode — RTOS / Cortex-M boot (providers/renode.ts) — VALIDATED (real Contiki on emulated STM32F4). ===
ARG RENODE_VER=1.16.1
RUN bash -c 'set -o pipefail; apt-get update && apt-get install -y --no-install-recommends libicu72 libssl3 ca-certificates && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL "https://github.com/renode/renode/releases/download/v${RENODE_VER}/renode-${RENODE_VER}.linux-arm64-portable-dotnet.tar.gz" -o /tmp/renode.tgz \
    && mkdir -p /opt/renode && tar xzf /tmp/renode.tgz -C /opt/renode --strip-components=1 && rm /tmp/renode.tgz \
    && ln -sf /opt/renode/renode /usr/local/bin/renode && renode --version | head -1' \
    || echo "Renode optional install failed — RTOS provider degrades honestly"

# === AFL++ — coverage-guided fuzzing (providers/fuzz.ts, qemu mode). Heavy source build (compiles QEMU). ===
# Placed BEFORE the download-based tools so a Ghidra/kernel tweak never invalidates this slow layer's cache.
# CPU_TARGET=aarch64 → fuzzes aarch64 guests here; rebuild with a different CPU_TARGET for arm/mips firmware.
RUN bash -c 'apt-get update && apt-get install -y --no-install-recommends git ninja-build meson pkg-config libglib2.0-dev libpixman-1-dev python3 flex bison make gcc g++ && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 https://github.com/AFLplusplus/AFLplusplus /afl \
    && make -C /afl source-only NO_NYX=1 \
    && (cd /afl/qemu_mode && CPU_TARGET=aarch64 ./build_qemu_support.sh) \
    && cp /afl/afl-fuzz /afl/afl-qemu-trace /afl/afl-showmap /afl/afl-tmin /usr/local/bin/ \
    && afl-fuzz --version && afl-qemu-trace --version | head -1' \
    || echo "AFL++ optional build failed — fuzzing provider degrades honestly"
ENV AFL_PATH=/afl

# === Emulation bring-up assets — libnvram shim (rung-2 chroot service) + firmadyne kernels (rung-3 full-system). ===
# Paths here are exactly what preflight (providers/preflight.ts) checks: /opt/libnvram/libnvram-<arch>.so, /opt/firmae/kernels/.
RUN bash -c 'apt-get update && apt-get install -y --no-install-recommends git build-essential \
       gcc-mipsel-linux-gnu gcc-mips-linux-gnu gcc-arm-linux-gnueabi gcc-aarch64-linux-gnu \
       libc6-dev-mipsel-cross libc6-dev-mips-cross libc6-dev-armel-cross libc6-dev-arm64-cross \
    && git clone --depth 1 https://github.com/firmadyne/libnvram /tmp/libnvram && mkdir -p /opt/libnvram \
    && make -C /tmp/libnvram CC=mipsel-linux-gnu-gcc  && cp /tmp/libnvram/libnvram.so /opt/libnvram/libnvram-mipsel.so && make -C /tmp/libnvram clean \
    && make -C /tmp/libnvram CC=mips-linux-gnu-gcc    && cp /tmp/libnvram/libnvram.so /opt/libnvram/libnvram-mips.so   && make -C /tmp/libnvram clean \
    && make -C /tmp/libnvram CC=arm-linux-gnueabi-gcc && cp /tmp/libnvram/libnvram.so /opt/libnvram/libnvram-arm.so    && make -C /tmp/libnvram clean \
    && make -C /tmp/libnvram CC=aarch64-linux-gnu-gcc && cp /tmp/libnvram/libnvram.so /opt/libnvram/libnvram-arm64.so \
    && rm -rf /tmp/libnvram /var/lib/apt/lists/*' \
    || echo "libnvram optional build failed — chroot-service rung degrades honestly"
# Kernels live in GitHub RELEASES (the old raw-repo path 404s). Asset names: vmlinux.mipsel.4 / vmlinux.mipseb.4 /
# zImage.armel / vmlinux.armel under FirmAE_kernel-v4.1 v1.0.
RUN bash -c 'mkdir -p /opt/firmae/kernels && cd /opt/firmae/kernels \
    && for a in vmlinux.mipsel.4 vmlinux.mipseb.4 zImage.armel vmlinux.armel; do \
         curl -fsSL "https://github.com/pr0v3rbs/FirmAE_kernel-v4.1/releases/download/v1.0/$a" -o "$a"; done' \
    || echo "firmadyne kernels optional download failed — full-system rung degrades honestly"

# === Ghidra headless — deep decompilation (providers/ghidra.ts). Adds ~1.5 GB (JDK 21 + Ghidra). ===
# Debian bookworm ships no JDK 21 (Ghidra 12.x needs it), so fetch a portable Temurin JDK 21 from the Adoptium
# binary API, and pin a DIRECT Ghidra release URL (an api.github.com "releases/latest" call gets rate-limited).
ARG GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.2_build/ghidra_12.1.2_PUBLIC_20260605.zip
ENV JAVA_HOME=/opt/jdk
ENV PATH=/opt/jdk/bin:$PATH
ENV GHIDRA_INSTALL_DIR=/opt/ghidra
RUN bash -c 'mkdir -p /opt/jdk \
    && curl -fsSL "https://api.adoptium.net/v3/binary/latest/21/ga/linux/aarch64/jdk/hotspot/normal/eclipse?project=jdk" | tar xz -C /opt/jdk --strip-components=1 \
    && curl -fsSL "$GHIDRA_URL" -o /tmp/ghidra.zip && unzip -q /tmp/ghidra.zip -d /opt && rm /tmp/ghidra.zip \
    && mv /opt/ghidra_* /opt/ghidra && ln -sf /opt/ghidra/support/analyzeHeadless /usr/local/bin/analyzeHeadless \
    && /opt/jdk/bin/java -version' \
    || echo "Ghidra optional install failed — decompiler degrades honestly"

# === sasquatch — patched unsquashfs for VENDOR/non-standard SquashFS (providers/extract.ts). Maintained onekey-sec
# .deb (no source build). `latest/download/<asset>` is a stable redirect — no api.github.com call to rate-limit.
# Placed LAST (a fast, volatile .deb layer) so it doesn't invalidate the slow tool builds above on a re-add. ===
RUN bash -c 'ARCH="$(dpkg --print-architecture)" \
    && curl -fsSL "https://github.com/onekey-sec/sasquatch/releases/latest/download/sasquatch_1.0_${ARCH}.deb" -o /tmp/sasquatch.deb \
    && apt-get update && apt-get install -y --no-install-recommends /tmp/sasquatch.deb \
    && rm -f /tmp/sasquatch.deb && rm -rf /var/lib/apt/lists/* && command -v sasquatch' \
    || echo "sasquatch optional install failed — vendor-SquashFS extraction degrades to unsquashfs"

# === angr — symbolic reachability (providers/symreach.ts). Adds ~1 GB (z3 + unicorn + pyvex + capstone). ===
# Installed into its OWN virtualenv, not the system python3: chipsec lives on the system interpreter and angr's
# dependency closure is large enough that sharing it invites a version conflict between two optional tools.
# `FIRMLAB_ANGR_PYTHON` is what tools.ts probes and what the provider executes, so the isolation is explicit
# rather than a PATH accident. Placed last — a failed install must degrade honestly, never fail the image.
ENV FIRMLAB_ANGR_PYTHON=/opt/angr-venv/bin/python3
RUN bash -c 'apt-get update && apt-get install -y --no-install-recommends python3-venv \
    && python3 -m venv /opt/angr-venv \
    && /opt/angr-venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/angr-venv/bin/pip install --no-cache-dir angr \
    && /opt/angr-venv/bin/python3 -c "import angr; print(\"angr\", angr.__version__)" \
    && rm -rf /var/lib/apt/lists/*' \
    || echo "angr optional install failed — symbolic reachability degrades honestly"

# === bettercap — active on-path positioning (capture/spoof.ts, Phase 6.2). ===
# It ships here because the 6.2 spoof leg was written against a toolchain that never carried it: the backend had
# been honestly reporting itself absent since the day it was written, which made active positioning a documented
# capability that did not exist. Installing it makes the capability real.
#
# Installing it does NOT make it usable everywhere, and `assessL2Reach` (capture/backends.ts, unit-tested) is what
# keeps that honest: ARP poisoning has to answer for the gateway on the TARGET's layer-2 segment, and a container
# on a Docker bridge network is not on it — its ARP frames never leave the private Docker subnet. So the backend
# gates on layer-2 reach BEFORE the binary or the caps, and a bridge-networked deployment is told the spoof is
# impossible there rather than being sent after a `--cap-add` that cannot help. Genuinely spoof-capable only under
# `--network host` + `--cap-add=NET_ADMIN --cap-add=NET_RAW`; the Traefik-fronted deploy is bridge-networked by
# design and its answer is the LAN capture agent (docs/CAPTURE-DESIGN.md §5b/§5c).
#
# Placed LAST, next to sasquatch/angr: a small, volatile apt layer must not invalidate the multi-GB tool builds
# above it — which is exactly what adding it to the capture block near the top of this file would have done.
RUN apt-get update && apt-get install -y --no-install-recommends bettercap \
    && rm -rf /var/lib/apt/lists/* && command -v bettercap \
    || echo "bettercap optional install failed — spoof positioning degrades honestly (LAN agent still works)"

# === fwhunt-scan — real UEFI implant detection (providers/fwhunt.ts). ===
# The ONLY honest route to implant detection here. Advanced implants (LoJax, MoonBounce, CosmicStrand, BlackLotus)
# are not reliably GUID-detectable and have no stable public file-GUIDs, which is exactly why FwHunt uses
# code-pattern rules (esil / hex strings / nvram) instead. Shipping a hand-curated GUID feed would have been
# fabrication dressed as intelligence, so FirmLab ships the SCANNER and the upstream RULES as data, and authors
# neither (docs/BACKLOG.md, UEFI section).
#
# Three parts, one layer:
#  - rizin, built from source: fwhunt-scan drives it through rzpipe, Debian bookworm has no `rizin` package, and
#    upstream publishes a Linux binary for x86_64 only — this deployment is arm64, so source is the only route.
#  - fwhunt-scan in its OWN venv (`FIRMLAB_FWHUNT_PYTHON`), because chipsec lives on the system interpreter and
#    runs against the SAME UEFI images; two optional tools sharing a dependency closure invites a version clash.
#  - the rule corpus, cloned from binarly-io/FwHunt (`FIRMLAB_FWHUNT_RULES`).
#
# Placed last with the other volatile layers, and fault-tolerant: a failed build must degrade the provider to
# `blocked_by_platform`, never fail the image.
ENV FIRMLAB_FWHUNT_PYTHON=/opt/fwhunt-venv/bin/python3
ENV FIRMLAB_FWHUNT_RULES=/opt/fwhunt-rules/rules

# Split in two so a failure is attributable: rizin is a long source build, fwhunt is a fast pip+clone. Keeping
# them in ONE layer already cost a silent half-install — `rm -rf /tmp/rz` deleted the shell's own working
# directory, and the pip that followed failed inside a cwd that no longer existed, which the `|| echo` then
# swallowed. Hence the `cd /` below: never leave the shell standing in a directory this recipe is about to remove.
RUN bash -c 'apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates xz-utils meson ninja-build pkg-config gcc g++ libc6-dev \
    && curl -fsSL https://github.com/rizinorg/rizin/releases/download/v0.9.1/rizin-src-v0.9.1.tar.xz -o /tmp/rz.tar.xz \
    && mkdir -p /tmp/rz && tar xf /tmp/rz.tar.xz -C /tmp/rz --strip-components=1 \
    && cd /tmp/rz && meson setup build --prefix=/usr/local --buildtype=release >/dev/null \
    && ninja -C build >/dev/null && ninja -C build install >/dev/null && ldconfig \
    && cd / && rm -rf /tmp/rz /tmp/rz.tar.xz \
    && rizin -v | head -1 \
    && rm -rf /var/lib/apt/lists/*' \
    || echo "rizin build failed — UEFI implant scanning degrades honestly"

RUN bash -c 'cd / && apt-get update && apt-get install -y --no-install-recommends git python3-venv \
    && python3 -m venv /opt/fwhunt-venv \
    && /opt/fwhunt-venv/bin/pip install --no-cache-dir fwhunt-scan \
    && git clone --depth 1 https://github.com/binarly-io/FwHunt /opt/fwhunt-rules \
    && /opt/fwhunt-venv/bin/python3 -c "import fwhunt_scan, rzpipe; print(\"fwhunt-scan ok\")" \
    && test -f /opt/fwhunt-venv/bin/fwhunt_scan_analyzer.py \
    && echo "FwHunt rules: $(find /opt/fwhunt-rules/rules -name \"*.yml\" | wc -l)" \
    && rm -rf /var/lib/apt/lists/*' \
    || echo "fwhunt-scan optional install failed — UEFI implant scanning degrades honestly"
