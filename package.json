{
  "name": "firmlab",
  "version": "0.1.0",
  "private": true,
  "description": "FirmLab \u2014 local-only firmware analysis workbench (structure map, entropy, filesystem, SBOM, emulation).",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "check": "pnpm -r run check",
    "test": "pnpm -r run test && node --test scripts/corpus-matrix.test.mjs scripts/fwhunt-campaign.test.mjs",
    "dev:api": "pnpm --filter @firmlab/api run dev",
    "dev:web": "pnpm --filter @firmlab/web run dev",
    "biome": "bash scripts/check-nul.sh && bash scripts/check-comment-glob.sh && bash scripts/check-web-api-mock.sh && biome check .",
    "biome:fix": "biome check --write .",
    "check:nul": "bash scripts/check-nul.sh",
    "check:comment-glob": "bash scripts/check-comment-glob.sh",
    "check:web-api-mock": "bash scripts/check-web-api-mock.sh",
    "test:yara-policy": "bash scripts/test-yara-policy.sh",
    "check:yara-release": "bash scripts/check-yara-release.sh --no-fail",
    "ui:up": "bash scripts/ui-expose.sh up",
    "ui:down": "bash scripts/ui-expose.sh down",
    "ui:shot": "node scripts/ui-drive.mjs",
    "corpus:matrix": "node scripts/corpus-matrix.mjs",
    "test:corpus-matrix": "node --test scripts/corpus-matrix.test.mjs",
    "fwhunt:campaign": "node scripts/fwhunt-campaign.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7",
    "playwright": "^1.57.0"
  }
}
