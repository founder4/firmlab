{
  "mcpServers": {
    "firmlab": {
      "command": "docker",
      "args": ["exec", "-i", "firmlab", "node", "/app/apps/api/dist/mcp/server.js"],
      "env": {}
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82", "--browser", "chromium", "--isolated"],
      "env": {}
    }
  }
}
